# Copy this file to .env and adjust as needed:  cp .env.example .env
# Never commit real secrets. .env is git-ignored.

# Where data is stored. A local SQLite file is created automatically by `npm run db:migrate`.
# Any libSQL URL also works (for example a hosted Turso database: libsql://your-db.turso.io).
DATABASE_URL="file:./data/marketplace.db"

# Only needed for a remote libSQL/Turso database. Leave empty for a local file.
DATABASE_AUTH_TOKEN=""

# How long a login lasts before users must sign in again (days).
SESSION_MAX_AGE_DAYS="30"

# Session cookies are marked Secure automatically in production (`npm start`).
# Set to "false" if you run a production build over plain HTTP on a non-localhost address.
# SESSION_COOKIE_SECURE="true"

# Password given to every demo account created by `npm run db:seed`.
# For local demos only — change it, and never reuse a real password here.
SEED_DEMO_PASSWORD="demo-password"

# Show the demo account hint on the login page. Set to "false" for a real deployment.
SHOW_DEMO_ACCOUNTS="true"

# Display name shown in the header and page titles.
NEXT_PUBLIC_APP_NAME="Talentloom"
